<%-layout("/layouts/boilerplate.ejs") %>

<div class="edit-profile-page">
    <div class="edit-header">
        <h1>Edit your profile</h1>
        <p>few changes in youe profile</p>
    </div>
    <form action="" enctype="multipart/form-data">
        <div class="form-group">
            <label for="profile-photo">Add a profile photo</label>
            <input id="profile-photo" type="file">
        </div>
        <div class="form-group">
            <label for="fullname">Add a fullname</label>
            <input id="fullname" type="text">
        </div>
        <div class="form-group">
            <label for="email">Add a email</label>
            <input id="email" type="email">
        </div>
        <div class="form-group">
            <label for="phone">Add a phone</label>
            <input id="phone" type="tel">
        </div>
        <div class="form-group">
            <label for="location">Add a location</label>
            <input id="location" type="text">
        </div>
        <div class="form-group">
            <label for="dateOfBirth">Add a date of birth</label>
            <input id="dateOfBirth" type="date">
        </div>
        <div class="form-group">
            <label for="gender">Add a gender</label>
            <select name="" id="gender">
                <option value="">male</option>
                <option value="female">female</option>
                <option value="">non ot these</option>
            </select>
        </div>
        <div class="form-group">
            <label for="bio">Add a bio</label>
            <textarea name="" id="bio"></textarea>
        </div>
        <div class="actions">
            <button>Save</button>
            <button>Cancel</button>
        </div>
    </form>
</div>