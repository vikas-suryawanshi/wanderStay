<%-layout("/layouts/boilerplate.ejs") %>
<div class="profile-page">
    <div class="profile-layout">
        <aside class="profile-sidebar">
            <div class="sidebar-brand">
                <h2>WanderStay</h2>
                <p>Your account</p>
            </div>
            <nav class="profile-navigation">
                <p class="sidebar-heading">Account</p>
                <a href="/profile" class="sidebar-link active">
                    <i class="fa-regular fa-user"></i>
                    <span>My Profile</span>
                </a>
                <a href="/dashboard" class="sidebar-link">
                    <i class="fa-solid fa-chart-line"></i>
                    <span>My Dashboard</span>
                </a>
                <a href="/bookings" class="sidebar-link">
                    <i class="fa-regular fa-calendar-check"></i>
                    <span>My Bookings</span>
                </a>
                <a href="/wishlist" class="sidebar-link">
                    <i class="fa-regular fa-heart"></i>
                    <span>Wishlist</span>
                </a>
                <div class="sidebar-host-section">
                    <div class="sidebar-divider"></div>
                    <p class="sidebar-heading">HOST</p>
                    <a href="/host/dashboard" class="sidebar-link">
                        <i class="fa-solid fa-house"></i>
                        <span>Host Dashboard</span>
                    </a>
                    <a href="/listings/new" class="sidebar-link">
                        <i class="fa-solid fa-circle-plus"></i>
                        <span>Add Property</span>
                    </a>
                </div>
            </nav>
            <form action="/logout" method="post" class="sidebar-logout-form">
                <button type="submit" class="sidebar-logout">
                    <i class="fa-solid fa-arrow-right-from-bracket"></i>
                    <span>Log Out</span>
                </button>
            </form>
            <div class="sidebar-footer">
                <i class="fa-regular fa-circle-check"></i>
                <span>Welcome to WanderStay</span>
            </div>
        </aside>

        <!-- main profile content -->
        <main class="profile-main">
            <!-- profile heading -->
            <div class="profile-header">
                <div>
                    <h1>My Profile</h1>
                    <p>Manage your personal information</p>
                </div>
                <a href="/profile/edit" class="profile-edit-button">
                    <i class="fa-regular fa-pen-to-square"></i>
                    Edit Profile
                </a>
            </div>
            <!-- profile card -->
            <section class="profile-card">
                <!-- profile identity -->
                <div class="profile-image-section">
                    <% if(user.image && user.image.url) {%>
                        <img
                            src="<%= user.image.url %>" alt="profile-photo" class="profile-avatar"
                        >
                    <% }else { %>
                        <div class="profile-avatar-placeholder">
                            <%= user.fullName? user.fullName.charAt(0).toUpperCase():"U"%>
                        </div>
                    <% } %>

                    <div class="profile-identity">
                        <h2><%= user.fullName || "User"%></h2>
                        <p class="profile-username">@<%= user.username || "User"%>
                        </p>
                        <p class="profile-member-label">WanderStay Member</p>
                    </div>
                </div>

                <!-- personal information -->
                <div class="profile-details">
                    <div class="profile-section-heading">
                        <div>
                            <h3>Personal Information</h3>
                            <p>Your personal details and contact information</p>
                        </div>
                    </div>
                    <div class="profile-info-grid">
                        <div class="profile-info-item">
                            <span class="profile-label">Full Name</span>
                            <p><%= user.fullName || "Not added"%></p>
                        </div>
                        <div class="profile-info-item">
                            <span class="profile-label">Username</span>
                            <p><%= user.username || "Not added"%></p>
                        </div>
                        <div class="profile-info-item">
                            <span class="profile-label">Email Address</span>
                            <p><%= user.email || "Not added"%></p>
                        </div>
                        <div class="profile-info-item">
                            <span class="profile-label">Phone Number</span>
                            <p><%= user.phone || "Not added"%></p>
                        </div>
                        <div class="profile-info-item">
                            <span class="profile-label">Location</span>
                            <p><%= user.location || "Not added"%></p>
                        </div>
                        <div class="profile-info-item">
                            <span class="profile-label">Date Of Birth</span>
                            <p>
                                <% if(user.dateOfBirth){ %>
                                    <%= new Date(user.dateOfBirth).toLocaleDateString("en-IN", {
                                            day: "2-digit",
                                            month: "long",
                                            year: "numeric"
                                    }) %>
                                <% } else { %>
                                    Not added
                                <% } %>
                            </p>
                        </div>
                        <div class="profile-info-item">
                            <span class="profile-label">Gender</span>
                            <p>
                                <% if(user.gender === "prefer-to-not-say") {%>
                                    Prefer not to say
                                <% } else if (user.gender) {%>
                                    <%= user.gender.charAt(0).toUpperCase()+user.gender.slice(1)%>
                                <% }else { %>
                                    Not added
                                <% } %>
                            </p>
                        </div>
                    </div>
                    <!-- About me -->
                    <div class="profile-bio">
                        <h3>About Me</h3>
                        <p><%= user.bio || "No bio added yet." %></p>
                    </div>
                </div>
            </section>
        </main>
    </div>
</div>