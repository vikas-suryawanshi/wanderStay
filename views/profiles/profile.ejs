<%-layout("/layouts/boilerplate.ejs") %>
<div class="profile-page">
    <div class="profile-container">
        <!-- profile heading -->
        <div class="profile-header">
            <div>
                <h1>My Profile</h1>
                <p>Manage your personal information</p>
            </div>
        </div>
        <!-- profile card -->
        <div class="profile-card">
            <!-- profile image -->
            <div class="profile-image-section">
                <% if(user.image && user.image.url) {%>
                    <img
                        src="<%= user.image.url %>" alt="profile-photo" class="profile-avatar"
                    >
                <% }else { %>
                    <div class="profile-avatar-placeholder">
                        <%= user.fullName? user.fullName.charAt(0).toUpperCase():"U"%>
                    </div>
                <% } %>
                <h2><%= user.fullName%></h2>
                <p class="profile-username">@<%= user.username%>
                </p>
            </div>
            <!-- profile information -->
            <div class="profile-details">
                <h3>Personal Information</h3>
                <div class="profile-info-grid">
                    <div class="profile-info-item">
                        <span class="profile-label">Full Name</span>
                        <p><%= user.fullName || "Not added"%></p>
                    </div>
                    <div class="profile-info-item">
                        <span class="profile-label">Username</span>
                        <p><%= user.username || "Not added"%></p>
                    </div>
                    <div class="profile-info-item">
                        <span class="profile-label">Email Address</span>
                        <p><%= user.email || "Not added"%></p>
                    </div>
                    <div class="profile-info-item">
                        <span class="profile-label">Phone Number</span>
                        <p><%= user.phone || "Not added"%></p>
                    </div>
                    <div class="profile-info-item">
                        <span class="profile-label">Location</span>
                        <p><%= user.location || "Not added"%></p>
                    </div>
                    <div class="profile-info-item">
                        <span class="profile-label">Date Of Birth</span>
                        <p>
                            <% if(user.dateOfBirth){ %>
                                <%= new Date(user.dateOfBirth).toLocaleDateString("en-IN", {
                                        day: "2-digit",
                                        month: "long",
                                        year: "numeric"
                                }) %>
                            <% } else { %>
                                Not added
                            <% } %>
                        </p>
                    </div>
                    <div class="profile-info-item">
                        <span class="profile-label">Gender</span>
                        <p><%= user.gender || "Not added" %></p>
                    </div>
                </div>
                <!-- bio -->
                <div class="profile-bio">
                    <span class="profile-label">About Me</span>
                    <p><%= user.bio || "No bio added yet." %></p>
                </div>
                <div class="profile-actions">
                    <form action="/profile/edit" method="get">
                        <button type="submit" class="profile-edit-button">
                            Edit Profile
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>