<p%-layout("/layouts/boilerplate.ejs") %>
<div class="container">
    <div class="profile-header">
        <h1>My Profile</h1>
    </div>
    <div class="profile-details">
        <p><%= user.image.url%></p>
        <p><%= user.fullName%></p>
        <p><%= user.username%></p>
        <p><%= user.email%></p>
        <p><%= user.phone%></p>
        <p><%= user.location%></p>
        <p><%= user.bio%></p>
        <p><%= user.dateOfBirth%></p>
        <p><%= user.gender%></p>
        <form>
            <button>Edit profile</button>
        </form>
    </div>
</div>