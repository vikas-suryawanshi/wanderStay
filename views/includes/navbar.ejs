<nav class="navbar navbar-expand-md bg-body-light border-bottom sticky-top">
  <div class="container-fluid">
    <a class="navbar-brand" href="/listings"><img src="/assets/wanderstay-logo.png" alt="WanderStay Logo"></a>
    <button class="navbar-toggler" type="button"
    data-bs-toggle="collapse"
    data-bs-target="#navbarNavAltMarkup"
    aria-controls="navbarNavAltMarkup"
    aria-expanded="false" aria-label="Toggle navigation"
    >
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
      <div class="navbar-nav ms-auto">
        <form action="/listings" method="get"
        class="d-flex" role="search">
          <input class="form-control me-2 search-inp" name="search"
          value="<%= typeof search !== 'undefined' ? search : '' %>"
          type="search" placeholder="Search Destination"
          aria-label="Search"/>
          <button class="btn search-btn"
          type="submit"><i class="fa-solid fa-magnifying-glass"
          ></i>Search</button>
        </form>
      </div>
      <div class="navbar-nav ms-auto align-items-md-center navbar-account">
        <% if(currUser) {%>
          <a class="profile-nav-link" href="/profile" aria-label="My Profile" title="My Profile">
            <% if(currUser.image && currUser.image.url) {%>
              <img
                src="<%= currUser.image.url%>"
                alt="profile"
                class="navbar-profile-image"
              >
            <% }else { %>
              <i class="fa-regular fa-circle-user profile-default-icon"></i>
            <% } %>
          </a>
        <% } else { %>
          <div class="profile-dropdown">
            <button type="button" class="profile-dropdown-toggle" aria-label="Open account menu"
            aria-expanded="false">
              <i class="fa-regular fa-circle-user profile-default-icon"></i>
            </button>
            <div class="profile-dropdown-menu">
              <a class="dropdown-login"
                href="/login">Log In
              </a>
              <a class="dropdown-signup" href="/signup">Sign Up</a>
            </div>
          </div>
        <% } %>
        <a href="/listings/new" class="nav-link">Start Hosting</a>
      </div>
    </div>
  </div>
</nav>