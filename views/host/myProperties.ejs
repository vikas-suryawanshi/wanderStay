<%-layout("/layouts/boilerplate.ejs") %>

<div class="my-properties-page">
    <!-- page header -->
    <div class="my-properties-header">
        <div class="my-properties-heading">
            <h1>My Properties</h1>
            <p>Manage your properties and keep your listings updated.</p>
        </div>
        <a href="/listings/new" class="add-property-btn">
            + Add Property
        </a>
    </div>
    <!-- main page -->
    <div class="my-properties-container">
        <div class="my-properties-grid">
            <div class="properties-card">
                <div class="property-card-image">
                    <img src="https://images.unsplash.com/photo-1564013799919-ab600027ffc6" alt="Beautiful house exterior"
                    >
                    <span class="property-card-badge">
                        Your Listing
                    </span>
                </div>
                <div class="property-card-content">
                    <div class="property-card-heading">
                        <h3 class="property-card-title">
                            Beautiful Mountain House
                        </h3>
                        <p class="property-card-location">
                            <i class="fa-solid fa-location-dot"></i>
                            Manali, India
                        </p>
                    </div>
                    <div class="property-card-price">
                        <span class="price-amount">₹5,000</span>
                        <span class="price-unit">/ night</span>
                    </div>
                    <div class="property-card-divider"></div>
                    <div class="property-card-actions">
                        <a href="#" class="edit-property-btn">
                            <i class="fa-regular fa-pen-to-square"></i>
                            Edit
                        </a>
                        <button type="button" class="delete-property-btn">
                            <i class="fa-regular fa-trash-can"></i>
                            Delete
                        </button>
                    </div>
                </div>
            </div>
        </div>
        <div class="my-properties-empty">
            <div class="empty-properties-icon">
                <i class="fa-solid fa-house"></i>
            </div>
            <h3>No Properties Yet</h3>
            <p>
                You haven't added any properties yet.
                Start hosting and share your space with travelers.
            </p>
            <a href="/listings/new" class="add-first-property-btn">
                Add Your First Properties
            </a>
        </div>
    </div>
</div>