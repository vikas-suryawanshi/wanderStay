<%-layout("/layouts/boilerplate.ejs") %>

<div class="host-dashboard">
    <!-- Dashboard header -->
    <header class="host-dashboard-header">
        <div class="dashboard-header-content">
            <h1>Host Dashboard</h1>
            <p>Manage your properties and bookings</p>
        </div>
        <a href="/listings/new" class="add-property-btn">
            <i class="fa-solid fa-plus"></i>
            Add Property
        </a>
    </header>

    <!-- Dashboard Overview -->
    <section class="dashboard-overview">
        <div class="overview-card">
            <div class="overview-card-info">
                <p>Total Properties</p>
                <h3><%= totalProperties%></h3>
            </div>
            <div class="overview-card-icon properties-icon">
                <i class="fa-solid fa-house"></i>
            </div>
        </div>
        <div class="overview-card">
            <div class="overview-card-info">
                <p>Total Bookings</p>
                <h3><%= totalBookings%></h3>
            </div>
            <div class="overview-card-icon bookings-icon">
                <i class="fa-solid fa-calendar-check"></i>
            </div>
        </div>

        <div class="overview-card">
            <div class="overview-card-info">
                <p>Completed Bookings</p>
                <h3><%= completedBookings%></h3>
            </div>
            <div class="overview-card-icon confirmed-icon">
                <i class="fa-solid fa-circle-check"></i>
            </div>
        </div>
        <div class="overview-card">
            <div class="overview-card-info">
                <p>Total Earnings</p>
                <h3>₹<%= totalEarnings.toLocaleString("en-IN")%></h3>
            </div>
            <div class="overview-card-icon earnings-icon">
                <i class="fa-solid fa-indian-rupee-sign"></i>
            </div>
        </div>
    </section>

    <!-- quick actions -->
    <section class="dashboard-quick-actions">
        <h2>Manage Your Hosting</h2>
        <div class="quick-actions-grid">
            <a href="/host/properties" class="quick-action-card">
                <i class="fa-solid fa-house"></i>
                <h3>My Properties</h3>
                <p>View and manage your listings</p>
                <i class="fa-solid fa-arrow-right action-arrow"></i>
            </a>

            <a href="/host/bookings" class="quick-action-card">
                <i class="fa-solid fa-calendar-check"></i>
                <h3>Booking Management</h3>
                <p>Manage guest reservations</p>
                <i class="fa-solid fa-arrow-right action-arrow"></i>
            </a>
            <a href="/host/earnings" class="quick-action-card">
                <i class="fa-solid fa-chart-line"></i>
                <h3>Earnings Summary</h3>
                <p>Review your booking amounts</p>
                <i class="fa-solid fa-arrow-right action-arrow"></i>
            </a>
        </div>
    </section>

    <!-- Recent Bookings -->
    <section class="dashboard-recent-bookings">
        <div class="recent-bookings-header">
            <div>
                <h2>Recent Bookings</h2>
                <p>Keep track of your latest reservations</p>
            </div>

            <a href="/host/bookings" class="view-all-bookings">
                View All
                <i class="fa-solid fa-arrow-right"></i>
            </a>
        </div>

        <div class="recent-bookings-content">
            <table class="recent-bookings-table">
                <thead>
                    <tr>
                        <th>Guest</th>
                        <th>Property</th>
                        <th>Check-in</th>
                        <th>Check-out</th>
                        <th>Status</th>
                        <th>Amount</th>
                    </tr>
                </thead>
                <tbody>
                    <% if(recentBookings.length >0) {%>
                        <% recentBookings.forEach(booking => {%>
                            <tr>
                                <td>
                                    <%= booking.user.fullName %>
                                </td>
                                <td>
                                    <%= booking.listing.title %>
                                </td>
                                <td>
                                    <%= booking.checkIn.toLocaleDateString("en-IN") %>
                                </td>
                                <td>
                                    <%= booking.checkOut.toLocaleDateString("en-IN") %>
                                </td>
                                <td>
                                    <span class="booking-status <%= booking.status %>">
                                        <%= booking.status %>
                                    </span>
                                </td>
                                <td>
                                    ₹<%= booking.totalPrice.toLocaleString("en-IN") %>
                                </td>
                            </tr>
                        <% }); %>
                    <% } else { %>
                        <tr>
                            <td colspan="6">
                                <div class="empty-bookings-state">
                                    <i class="fa-solid fa-calendar-days"></i>
                                    <h3>No Recent Bookings</h3>
                                    <p>Your recent reservations will appear here.</p>
                                </div>
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </section>
</div>