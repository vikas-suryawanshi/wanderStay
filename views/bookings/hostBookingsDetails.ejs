<% layout("/layouts/boilerplate.ejs")  %>

<div class="container">
    <a href="/host/bookings" class="back-link">
        ← Back to Host Bookings
    </a>
    <div class="host-booking-details-card">
        <div class="booking-property-section">
            <div class="booking-property-image">
                <img src="<%= booking.listing.image.url %>" alt="property-image">
            </div>
            <div class="booking property-info">
                <h1><%= booking.listing.title %></h1>
                <p><%= booking.listing.country %>,<%= booking.listing.location%></p>
                <span class="booking-status <%= booking.status%>"><%= booking.status %></span>
            </div>
        </div>
    </div>
</div>