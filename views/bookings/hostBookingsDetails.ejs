<% layout("/layouts/boilerplate.ejs")  %>

<div class="container">
    <a href="/host/bookings" class="back-link">
        ← Back to Host Bookings
    </a>
    <h1>Booking Details</h1>
    <div class="host-booking-details-card">
        <div class="booking-property-section">
            <div class="booking-property-image">
                <img src="<%= booking.listing.image.url %>" alt="property-image">
            </div>
            <div class="booking-property-info">
                <h1><%= booking.listing.title %></h1>
                <p><%= booking.listing.location%>, <%= booking.listing.country %></p>
                <span class="booking-status <%= booking.status%>"><%= booking.status%></span>
            </div>
        </div>
        <div class="booking-guest-section">
            <h2>Guest Details</h2>
            <div class="booking-guest-info">
                <div class="guest-name">
                    <label for="guest-name"> Guest Name </label>
                    <p id="guest-name"><%= booking.user.fullName%></p>
                </div>
                <div class="guest-email">
                    <label for="guest-email"> Guest Email</label>
                    <p id="guest-email"><%= booking.user.email%></p>
                </div>
                <div class="guests">
                    <label for="guests">Number of Guests</label>
                    <p id="guests"><%= booking.guests%></p>
                </div>
            </div>
        </div>
        <div class="booking-stay-section">
            <h2>Stay Details</h2>
            <div class="booking-stay-info">
                <div class="stay-info-item">
                    <label for="Check-in">Check-in</label>
                    <p id="Check-in"><%= booking.checkIn.toLocaleDateString("en-US",{
                        month: "short",
                        day: "numeric",
                        year: "numeric"
                    }) %></p>
                </div>
                <div class="stay-info-item">
                    <label for="Check-out">Check-out</label>
                    <p id="Check-out"><%= booking.checkOut.toLocaleDateString("en-US",{
                        month: "short",
                        day: "numeric",
                        year: "numeric"
                    }) %></p>
                </div>
            </div>
        </div>
        <div class="booking-price-section">
            <h2>Payment Details</h2>
            <div class="booking-price-info">
                <div class="price-info-item">
                    <label for="total-price">Total Amount</label>
                    <p id="total-price">₹<%= booking.totalPrice.toLocaleString("en-IN")%></p>
                </div>
            </div>
        </div>
        <div class="booking-info-section">
            <h2>Booking Information</h2>
            <div class="booking-meta-info">
                <div class="meta-info-item">
                    <label for="booked-on">Booking Date</label>
                    <p id="booked-on"><%= booking.createdAt.toLocaleDateString("en-US",{
                        month: "short",
                        day: "numeric",
                        year: "numeric"
                    }) %></p>
                </div>
            </div>
        </div>
        <div class="booking-host-actions">
            <h2>Manage Booking</h2>
            <% if(booking.status === "pending") {%>
                <form method="post" action="/host/bookings/<%= booking._id%>/status">
                    <input type="hidden" name="status" value="confirmed">
                    <button type="submit" class="btn btn-secondary">Confirm Booking</button>
                </form>
                <form method="post" action="/host/bookings/<%= booking._id%>/status">
                    <input type="hidden" name="status" value="cancelled">
                    <button type="submit" class="btn btn-danger">Decline Booking</button>
                </form>
            <% } %>
            <% if(booking.status === "confirmed") {%>
                <form method="post" action="/host/bookings/<%= booking._id%>/status">
                    <input type="hidden" name="status" value="completed">
                    <button type="submit" class="btn btn-primary">Mark as Completed</button>
                </form>
                <form method="post" action="/host/bookings/<%= booking._id%>/status">
                    <input type="hidden" name="status" value="cancelled">
                    <button type="submit" class="btn btn-danger">Cancel Booking</button>
                </form>
            <% } %>
        </div>
    </div>
</div>