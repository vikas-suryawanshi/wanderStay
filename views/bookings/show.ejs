<% layout("/layouts/boilerplate.ejs")  %>
<div class="container booking-details-page">
    <div class="booking-page-header">
        <h3>Booking Details</h3>
        <p>Review your reservation information</p>
    </div>
    <div class="booking-details-card">
        <div class="image-section">
            <% if(booking.listing && booking.listing.image && booking.listing.image.url) {%>
                <img alt="booking-image" src="<%= booking.listing.image.url %>">
            <% }else { %>
                <img alt="Property unavailable" src="/images/default-property.jpg">
            <% } %>
        </div>
        <div class="content-section">
            <h4><%= booking.listing?booking.listing.title:"Property no longer available" %></h4>
            <p>Location: <%= booking.listing?booking.listing.location:"N/A" %>, <%= booking.listing?booking.listing.country:"N/A" %></p>
            <div class="booking-information">
                <span>
                    <small>Check-in</small>
                    <strong>
                        <%= booking.checkIn.toLocaleDateString("en-IN", {
                            day: "2-digit",
                            month: "short",
                            year: "numeric"
                        })%>
                    </strong>
                </span>
                <span>
                    <small>Check-out</small>
                    <strong>
                        <%= booking.checkOut.toLocaleDateString("en-IN", {
                            day: "2-digit",
                            month: "short",
                            year: "numeric"
                        })%>
                    </strong>
                </span>
                <span>
                    <small>Guests</small>
                    <strong><%= booking.guests %></strong>
                </span>
                <span>
                    <small>Total Price</small>
                    <strong>&#8377; <%= booking.totalPrice.toLocaleString("en-IN") %></strong>
                </span>
                <span class="myBooking-status <%= booking.status%>">
                    Status: <%= booking.status%>
                </span>
                <% if(booking.user && currUser._id.equals(booking.user._id)) {%>
                    <div class="guest-actions">
                        <% if(booking.status === "pending" || booking.status === "confirmed") {%>
                            <form method="post" action="/bookings/<%= booking._id %>/cancel">
                                <button class="btn btn-danger">Cancel</button>
                            </form>
                        <% } %>
                    </div>
                <%}%>
            </div>
        </div>
    </div>
</div>