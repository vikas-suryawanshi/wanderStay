<% layout("/layouts/boilerplate.ejs")  %>

<div class="container">
    <h1>Host Bookings</h1>
    <% if(hostBookings.length === 0) {%>
        <div class="empty-bookings">
            <div class="empty-bookings-icon">
                <i class="fa-solid fa-calendar-check"></i>
            </div>
            <h3>No bookings yet</h3>
            <p>Your properties haven't received any reservations yet.</p>
            <a href="/listings" class="btn btn-dark">View My Listings</a>
        </div>
    <% } else{%>
        <p>Manage your property reservations</p>
        <div class="filter-section">
            <button class="booking-filter active">All</button>
            <button class="booking-filter">Pending</button>
            <button class="booking-filter">Confirmed</button>
            <button class="booking-filter">Completed</button>
            <button class="booking-filter">Cancelled</button>
        </div>
        <div class="host-booking-grid">
            <% for(booking of hostBookings) {%>
                <div class="host-booking-card">
                    <div class="host-booking-image">
                        <img src="<%= booking.listing.image.url %>" alt="booking-image">
                    </div>
                    <div class="host-booking-content">
                        <h3><%= booking.listing.title %></h3>
                        <p><%= booking.user.fullName %></p>
                        <div class="booking-info">
                            <p><%= booking.checkIn.toLocaleDateString()%> → <%= booking.checkOut.toLocaleDateString() %></p>
                            <p><%=booking.guests%> Guests</p>
                        </div>
                        <span class="booking-status <%= booking.status%>"><%= booking.status %></span>
                        <span class="view-booking">View booking →</span>
                    </div>
                </div>
            <% } %>
        </div>
    <% } %>
</div>