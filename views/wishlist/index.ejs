<%-layout("/layouts/boilerplate.ejs") %>
<div class="container">
    <div class="wishlist-header">
        <h2>My Wishlist</h2>
        <p>Your favorite stays, all in one place.</p>
    </div>
    <% if(listings.length === 0) {%>
        <div class="empty-bookings">
            <div class="empty-bookings-icon">
                <i class="fa-regular fa-calendar-xmark"></i>
            </div>
            <h3>Your Wishlist is Empty</h3>
            <p>Save your favorite stays and find them here.</p>
            <a href="/listings" class="btn btn-dark">Explore Stays</a>
        </div>
    <% } %>
    <% for(const listing of listings) {%>
        <div class="wishlist-card">
            <div class="wishlist-image">
                <img src="<%= listing.image.url%>" alt="<%= listing.title%>">
            </div>
            <div class="card-body">
                <p><%= listing.title%></p>
                <span><%= listing.location%>,<%= listing.country%></span>
                <a href="/listings/<%= listing._id%>">
                    View Listing →
                </a>
                <form method="post" action="/listings/<%=listing._id%>/wishlist/remove">
                    <button>remove from wishlist</button>
                </form>
            </div>
        </div>
    <% } %>
</div>