<% layout("/layouts/boilerplate.ejs")  %>
<div class="container">
    <% for(listing of listings) {%>
        <div class="wishlist-image">
            <img src="<%= listing.image.url%>" alt="<%= listing.title%>">
        </div>
        <div class="card-body">
            <p><%= listing.title%></p>
            <span><%= listing.location%>,<%= listing.country%></span>
        </div>
    <% } %>
</div>