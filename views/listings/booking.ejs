<% layout("/layouts/boilerplate.ejs")  %>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="text-center mb-4">
                <h2 class="fw-semibold mb-2">Reserve Your Stay</h2>
                <p class="text-muted mb-0">
                    Choose your dates and number of guests
                </p>
            </div>

            <div class="card booking-card shadow-sm border-0 rounded-4 overflow-hidden">
                <div class="booking-listing-preview">
                    <img
                        src="<%= listings.image.url %>"
                        alt="<%= listings.title %>"
                        class="booking-listing-img"
                    >
                    <div class="p-3">
                        <h5 class="fw-semibold mb-1">
                            <%= listings.title %>
                        </h5>

                        <p class="text-muted mb-2">
                            <i class="fa-solid fa-location-dot me-1"></i>
                            <%= listings.location %>, <%= listings.country %>
                        </p>

                        <p class="mb-0">
                            <span class="fw-bold">
                                &#8377; <%= listings.price.toLocaleString("en-IN") %>
                            </span>
                            <span class="text-muted">
                                / night
                            </span>
                        </p>
                    </div>
                </div>
                <div class="card-body p-4 p-md-5">
                    <form method="post" action="/listings/<%= listings._id %>/book"
                        class="needs-validation" novalidate>
                        <div class="mb-4">
                            <label for="checkIn" class="form-label fw-semibold"
                            >Check-in</label>

                            <input name="checkIn" id="checkIn" type="date"
                                class="form-control booking-input" required >
                                <div class="invalid-feedback">please enter a valid checkIn date.</div>
                        </div>
                        <div class="mb-4">
                            <label for="checkOut" class="form-label fw-semibold"
                            >Check-out</label>

                            <input name="checkOut" id="checkOut" type="date"
                                class="form-control booking-input" required >
                                <div class="invalid-feedback">please enter a valid checkOut date.</div>
                        </div>
                        <div class="mb-4">
                            <label for="guests" class="form-label fw-semibold"
                            >guests</label>
                            <input name="guests" id="guests" type="number"
                                class="form-control booking-input"
                                min="1" value="1" required>
                                <div class="invalid-feedback">please give the no.of guests stay in this.</div>
                        </div>
                        <button
                            type="submit"
                            class="btn btn-dark w-100 booking-btn"
                        >
                            <i class="fa-solid fa-calendar-check me-2"></i>
                            Reserve Your Stay
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>