<% layout("/layouts/boilerplate.ejs")  %>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="text-center mb-4">
                <h2 class="fw-semibold mb-2">Reserve Your Stay</h2>
                <p class="text-muted mb-0">
                    Choose your dates and number of guests
                </p>
            </div>

            <div class="card booking-card shadow-sm border-0 rounded-4 overflow-hidden">
                <div class="booking-listing-preview">
                    <img
                        src="<%= listings.image.url %>"
                        alt="<%= listings.title %>"
                        class="booking-listing-img"
                    >
                    <div class="p-3">
                        <h5 class="fw-semibold mb-1">
                            <%= listings.title %>
                        </h5>

                        <p class="text-muted mb-2">
                            <i class="fa-solid fa-location-dot me-1"></i>
                            <%= listings.location %>, <%= listings.country %>
                        </p>

                        <p class="mb-0">
                            <span class="fw-bold">
                                &#8377; <%= listings.price.toLocaleString("en-IN") %>
                            </span>
                            <span class="text-muted">
                                / night
                            </span>
                        </p>
                    </div>
                </div>
                
            </div>
        </div>
    </div>
</div>



<h3>Reserve Your Stay</h3>
<form method="post" action="/listings/<%= listings._id %>/book">
        <label for="checkIn" class="form-label">select checkIn</label>
        <input name="checkIn" id="checkIn"
            type="date" class="form-control" required
        >

        <label for="checkOut" class="form-label">select checkOut</label>
        <input name="checkOut" id="checkOut"
            type="date" class="form-control" required
        >

        <label for="guests" class="form-label">select Guests</label>
        <input name="guests" id="guests"
            type="number" class="form-control" required
        >

        <button class="btn btn-success">Submit</button>
</form>