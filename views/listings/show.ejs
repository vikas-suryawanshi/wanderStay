<% layout("/layouts/boilerplate.ejs")  %>
<script>
    mapToken= "<%= process.env.MAP_TOKEN %>";
    const listing = <%- JSON.stringify(listings) %>;
</script>
<div class="container">
    <div class="row mt-4">
        <div class="col-12 col-md-8 offset-md-2">
            <h2><b><%=listings.title%></b></h2>
        </div>
        <div class="card col-12 col-md-8 offset-md-2 show-card listing-card">
            <img src="<%=listings.image.url%>" class="card-img-top show-img" alt="listings_image">
            <div class="card-body">
                <p class="card-text mt-2">
                    <span class="text-muted">Owned By:</span>
                    <span class="fw-semibold ms-1"><%= listings.owner.username%></span>
                </p>
                <p class="card-text mt-3"><%= listings.description%></p>
                <p class="card-text fw-bold fs-5 mt-3">&#8377; <%= listings.price.toLocaleString("en-IN")%><span class="fw-normal fs-6">/night</span></p>
                <p class="card-text mt-2"
                ><%= listings.location%>, <%= listings.country%>
                </p>
            </div>
        </div>
        <% if(currUser && currUser._id.equals(listings.owner._id))  {%>
            <div class="btns mt-3 mb-3 col-12 col-md-8 offset-md-2 d-flex flex-wrap gap-3 justify-content-center">
                <form method="GET" action="/listings/<%= listings._id %>/edit">
                    <button class="btn btn-outline-primary px-4">
                        <i class="fa-solid fa-pen-to-square me-2"></i>Edit
                    </button>
                </form>
                <form method="POST" action="/listings/<%= listings.id %>?_method=DELETE">
                    <button type="submit" class="btn btn-outline-danger px-4
                    justify-content-center">
                        <i class="fa-solid fa-trash me-2"></i>Delete
                    </button>
                </form>
            </div>
        <% } %>
            <div class="col-12 col-md-8 offset-md-2">
                <% if(currUser) {%>
                    <hr/>
                    <h4>Leave a Review ⭐</h4>
                    <form method="post" action="/listings/<%=listings.id%>/reviews" novalidate class="needs-validation">
                        <div class="mt-3 mb-3">
                            <label for="range" class="form-label fw-semibold">Rating</label>
                            <fieldset class="starability-slot">
                                <input type="radio" id="no-rate" class="input-no-rate"
                                name="review[rating]" value="0" checked aria-label="No rating." />
                                <input type="radio" id="first-rate1"
                                name="review[rating]" value="1" />
                                <label for="first-rate1" title="Terrible">1 star</label>
                                <input type="radio" id="first-rate2"
                                name="review[rating]" value="2" />
                                <label for="first-rate2" title="Not good">2 stars</label>
                                <input type="radio" id="first-rate3"
                                name="review[rating]" value="3" />
                                <label for="first-rate3" title="Average">3 stars</label>
                                <input type="radio" id="first-rate4"
                                name="review[rating]" value="4" />
                                <label for="first-rate4" title="Very good">4 stars</label>
                                <input type="radio" id="first-rate5"
                                name="review[rating]" value="5" />
                                <label for="first-rate5" title="Amazing">5 stars</label>
                            </fieldset>
                        </div>
                        <div class="mt-3 mb-3">
                            <label for="comment" class="form-label fw-semibold">Comment</label>
                            <textarea type="text" cols="10" rows="5" id="comment" class="form-control"
                            name="review[comment]" required></textarea>
                            <div class="invalid-feedback">please enter a comment</div>
                        </div>
                        <button class="btn btn-dark mb-3 px-4">Submit</button>
                    </form>
                <% } %>
                <% if(listings.reviews.length) {%>
                    <hr/>
                    <h4 class="fw-semibold mb-3">⭐ Ratings & Reviews</h4>
                    <div class="row g-3">
                        <% for(review of listings.reviews){%>
                            <div class="card col-12 col-md-5 mb-3 shadow-sm rounded-3">
                                <div class="card-body p-4">
                                    <h5 class="card-title fw-semibold mb-2">
                                        <%= review.author.username%>
                                    </h5>
                                    <p class="starability-result"
                                    data-rating="<%=review.rating%>"></p>
                                    <p class="card-text mt-2"><%=review.comment%></p>
                                    <% if(currUser && currUser._id.equals(review.author._id)) {%>
                                        <form method="post"
                                        action="/listings/<%=listings.id%>/reviews/<%=review.id%>?_method=DELETE">
                                            <button class="btn btn-outline-danger btn-sm mb-2">Delete</button>
                                        </form>
                                    <% } %>
                                </div>
                            </div>
                        <%}%>
                    </div>
                <% } %>
            </div>
    </div>
    <div class="row mt-5">
        <div class="col-12 col-md-8 offset-md-2">
            <h2  class="fw-semibold mb-3">Where you’ll be</h2>
            <div id="map"></div>
        </div>
    </div>
    <script src="/js/map.js"></script>
</div>