<% layout("/layouts/boilerplate.ejs")  %>
<div class="row mt-3">
    <div class="col-8 offset-2">
        <h2><b><%=listings.title%></b></h2>
    </div>
    <div class="card col-6 offset-2 show-card listing-card">
        <img src="<%=listings.image%>" class="card-img-top show-img" alt="listings_image">
        <div class="card-body">
            <p class="card-text mt-2">Owned by:<%= listings.owner.username%></p>
            <p class="card-text mt-2"><%= listings.description%></p>
            <p class="card-text mt-2">&#8377; <%= listings.price.toLocaleString("en-IN")%>/night</p>
            <p class="card-text mt-2"><%= listings.location%></p>
            <p class="card-text mt-2"><%= listings.country%></p> 
        </div>
    </div>
    <% if(currUser && currUser._id.equals(listings.owner._id)) {%>
        <div class="btns mt-3 mb-3 col-6 offset-2 d-flex gap-5">
            <form method="GET" action="/listings/<%= listings._id %>/edit">
                <button class="btn btn-primary">
                    <i class="fa-solid fa-pen-to-square me-2"></i>Edit
                </button>
            </form>
            <form method="POST" action="/listings/<%= listings.id %>?_method=DELETE">
                <button type="submit" class="btn btn-danger">
                    <i class="fa-solid fa-trash me-2"></i>Delete
                </button>
            </form>
        </div>
    <% } %>
        <div class="col-8 offset-2">
            <% if(currUser) {%>
                <hr/>
                <h4>Leave a Review ⭐</h4>
                <form method="post" action="/listings/<%=listings.id%>/reviews" novalidate class="needs-validation">
                    <div class="mt-4 mb-3">
                        <label for="range" class="form-label">Range</label>
                        <input type="range" min="1" max="5" id="range" class="form-range" 
                        name="review[rating]">
                    </div>
                    <div class="mt-3 mb-3">
                        <label for="comment" class="form-label">Comment</label>
                        <textarea type="text" cols="10" rows="5" id="comment" class="form-control" 
                        name="review[comment]" required></textarea>
                        <div class="invalid-feedback">please enter a comment</div>
                    </div>
                    <button class="btn btn-outline-dark mb-3">Submit</button>
                </form>
            <% } %>
            <hr/>
            <h4><b>⭐ Ratings & Reviews</b></h4>
            <div class="row">
                <% for(review of listings.reviews){%>
                    <div class="card col-5 mb-3 ms-3">
                        <div class="card-body">
                            <h5 class="card-title"><%= review.author.username%></h5>
                            <p class="card-text"><%=review.comment%></p>
                            <p class="card-text"><%=review.rating%> stars</p>
                            <form method="post" 
                            action="/listings/<%=listings.id%>/reviews/<%=review.id%>?_method=DELETE">
                                <button class="btn btn-dark btn-sm mb-3">Delete</button>
                            </form>
                        </div>
                    </div>
                <%}%>
            </div>    
        </div>
    </div>
</div>    