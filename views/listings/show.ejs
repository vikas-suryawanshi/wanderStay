<% layout("/layouts/boilerplate.ejs")  %>
<div class="row mt-3">
    <div class="col-8 offset-2">
        <h2><b><%=listings.title%></b></h2>
    </div>
    <div class="card col-6 offset-2 show-card">
        <img src="<%=listings.image%>" class="card-img-top show-img" alt="listings_image">
        <div class="card-body">
            <p class="card-text mt-2">
                <%= listings.description%><br/>
                &#8377; <%= listings.price.toLocaleString("en-IN")%><br/>
                <%= listings.location%><br/>
                <%= listings.country%><br/>
            </p>    
        </div>
    </div>
    <div class="btns mt-3 mb-3">
        <a href="/listings/<%= listings._id%>/new " class="btn btn-dark edit-btn offset-2 col-1">Edit</a>
        <br/> <br/>
        <form  class="btn offset-1" method="post" action="/listings/<%=listings.id%>?_method=DELETE">
            <button class="btn offset-1 btn-danger">delete</button>
        </form>
    </div>
    <div class="col-8 offset-2">
        <hr/>
        <h4>Leave a comment</h4>
        <form method="post" action="/listings/<%=listings.id%>/reviews" novalidate class="needs-validation">
            <div class="mt-3 mb-3">
                <label for="range" class="form-label">Range</label>
                <input type="range" min="1" max="5" id="range" class="form-range" 
                name="review[rating]">
            </div>
            <div class="mt-3 mb-3">
                <label for="comment" class="form-label">Comment</label>
                <textarea type="text" cols="10" rows="5" id="comment" class="form-control" 
                name="review[comment]" required></textarea>
                <div class="invalid-feedback">please enter a comment</div>
            </div>
            <button class="btn btn-outline-dark mb-3">Submit</button>
        </form>
    </div>
</div>