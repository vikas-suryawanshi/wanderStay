<% layout("/layouts/boilerplate.ejs") %>

<div id="filters">
    <div class="filter" id="All">
        <div><i class="fa-solid fa-border-all"></i></div>
        <p>All</p>
    </div>
    <div class="filter" id="TrendingFilter">
        <div><i class="fa-solid fa-fire"></i></div>
        <P>Trending</P>
    </div>
    <div class="filter" id="villaFilter">
        <div><i class="fa-solid fa-house-chimney"></i></div>
        <P>Villa</P>
    </div>
    
    <div class="filter" id="roomsFilter">
        <div><i class="fa-solid fa-hotel"></i></div>
        <P>Rooms</P>
    </div>
    <div class="filter" id="castlesFilter">
        <div><i class="fa-solid fa-chess-rook"></i></div>
        <P>Castles</P>
    </div>
    <div class="filter" id="Iconic-CityFilter">
        <div><i class="fa-solid fa-city"></i></div>
        <p>Iconic Cities</p>
    </div>
    <div class="filter" id="beachFilter">
        <div class=""><i class="fa-solid fa-umbrella-beach"></i></div>
        <p>Beach</p>
    </div>
    <div class="filter" id="MountainFilter">
        <div class=""><i class="fa-solid fa-mountain"></i></div>
        <p>Mountain City</p>
    </div>
    <div class="filter" id="CampingFilter">
        <div class=""><i class="fa-solid fa-tent"></i></div>
        <p>Camping</p>
    </div>
    <div class="tax-switch">
        <div class="form-check-reverse form-switch">
            <input class="form-check-input"
            type="checkbox" role="switch"
            id="switchCheckDefault">
            <label class="form-check-label"
            for="switchCheckDefault"
            >Display Price After Incliding GST</label>
        </div>
    </div>
</div>
<div class="row row-cols-lg-4 row-cols-md-3 row-cols-sm-2 mt-2">
    <% for(let listings of allListings){%>
        <a href="/listings/<%=listings._id%>" class="listing-link"
            data-category="<%= listings.category%>">
            <div class="card listing-card">
                <img src="<%= listings.image.url %>" class="card-img-top"
                alt="listings-image" style="height: 15rem;">
                <div class="card-img-overlay"></div>
                <div class="card-body">
                    <p class="card-text ms-2"><b><%= listings.title %></b><br/>&#8377;
                        <i class="tax-info" data-price="<%= listings.price%>"><%= listings.price.toLocaleString("en-IN") %></i>/night
                    </p>

                </div>
            </div>
        </a>
    <%}%>
</div>
<script src="./js/taxSwitch.js"></script>
<script src="./js/filter.js"></script>