<% layout("/layouts/boilerplate.ejs") %>
<style>
    #filters{
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
    }
    .filter{
        text-align: center;
        margin-right: 3rem;
        margin-top: 2rem;
    }
</style>
<div id="filters">
    <div class="filter">
        <div><i class="fa-solid fa-border-all"></i></div>
        <p>All</p>
    </div>
    <div class="filter">
        <div><i class="fa-solid fa-fire"></i></div>
        <P>Trending</P>
    </div>
    <div class="filter">
        <div><i class="fa-solid fa-house-chimney"></i></div>
        <P>Villa`s</P>
    </div>
    
    <div class="filter">
        <div><i class="fa-solid fa-hotel"></i></div>
        <P>Rooms</P>
    </div>
    <div class="filter">
        <div><i class="fa-solid fa-chess-rook"></i></div>
        <P>Castles</P>
    </div>
</div>
<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-2">
    <% for(let listings of allListings){%>
        <a href="/listings/<%=listings._id%>" class="listing-link">
            <div class="card listing-card">
                <img src="<%= listings.image.url %>" class="card-img-top"
                alt="listings-image" style="height: 20rem;">
                <div class="card-img-overlay"></div>
                <div class="card-body">
                    <p class="card-text"><b><%= listings.title %></b><br/>&#8377;
                        <%= listings.price.toLocaleString("en-IN") %>/night</p>
                </div>
            </div>
        </a>    
    <%}%>    
</div>