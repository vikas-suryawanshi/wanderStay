<%-layout("/layouts/boilerplate.ejs") %>

<div class="container notification-page">
    <!-- page header -->
    <div class="notification-header">
        <div>
            <h2>Notifications</h2>
            <p>Stay updated with your bookings and activities.</p>
        </div>
        <% if(notifications.some(n => !n.isRead)) {%>
            <form action="/notifications/mark-all-read" method="post">
                <button type="button" class="mark-all-read-btn">
                    Mark all as read
                </button>
            </form>
        <% } %>
    </div>
    <div class="notification-list">
        <% if(notifications.length === 0) {%>
            <!-- empty state -->
            <div class="notification-empty">
                <i class="fa-regular fa-bell"></i>
                <h3>No notification yet</h3>
                <p>When you recive notifications, they will appear here.</p>
                <a href="/listings" class="btn btn-dark">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    Explore Stays
                </a>
            </div>
        <% } else {%>
            <% for(const notification of notifications) {%>
                <a href="<%= notification.link || '/notifications'%>" class="notification-item <%= notification.isRead? 'read':'unread'%>">

                    <div class="notification-icon">
                        <% if(notification.type === "booking") {%>
                            <i class="fa-regular fa-calendar-check"></i>
                        <% } else if (notification.type === "cancellation"){%>
                            <i class="fa-regular fa-calendar-xmark"></i>
                        <% } else if (notification.type === "booking_update") {%>
                            <i class="fa-solid fa-rotate"></i>
                        <% } else{ %>
                            <i class="fa-regular fa-bell"></i>
                        <% } %>
                    </div>
                    <!-- notification content -->
                    <div class="notification-content">
                        <p class="notification-message">
                            <%= notification.message%>
                        </p>
                        <small class="notification-time">
                            <%= notification.createdAt.toLocaleString("en-IN",{
                                day:"2-digit",
                                month:"short",
                                year:"numeric",
                                hour:"2-digit",
                                minute:"2-digit"
                            })%>
                        </small>
                    </div>
                    <!-- unread indicator -->
                    <% if(!notification.isRead) {%>
                        <span class="unread-dot"></span>
                    <% } %>
                </a>
            <% } %>
        <% } %>
    </div>
</div>