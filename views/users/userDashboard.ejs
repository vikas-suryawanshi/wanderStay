<%-layout("/layouts/boilerplate.ejs") %>

<div class="user-dashboard-container">
    <!-- header of page  -->
    <div class="user-dashboard-header">
        <div class="">
            <p class="user-dashboard-subtitle">WANDERSTAY / YOUR ACCOUNT</p>
            <h1>Welcome back, <%= currUser.fullName%>!</h1>
            <p>Manage your bookings and plan your next adventure.</p>
        </div>
        <div class="user-dashboard-header-icon">
            <i class="fa-solid fa-suitcase-rolling"></i>
        </div>
    </div>
    <!-- statitics -->
    <div class="user-dashboard-stats">
        <div class="user-stat-card">
            <div class="user-stat-icon booking-icon">
                <i class="fa-solid fa-calendar-check"></i>
            </div>
            <div class="">
                <p>Total Bookings</p>
                <h2><%= totalBookings%></h2>
            </div>
        </div>
        <div class="user-stat-card">
            <div class="user-stat-icon trip-icon">
                <i class="fa-solid fa-plane-departure"></i>
            </div>
            <div class="">
                <p>Upcoming Trips</p>
                <h2><%= upcomingTrips%></h2>
            </div>
        </div>
        <div class="user-stat-card">
            <div class="user-stat-icon wishlist-icon">
                <i class="fa-solid fa-heart"></i>
            </div>
            <div class="">
                <p>Wishlist</p>
                <h2><%= wishlistCount%></h2>
            </div>
        </div>
    </div>
    <!-- upcoming trips -->
    <div class="user-dashboard-section">
        <div class="user-section-heading">
            <div class="">
                <h2>Your Upcoming Trips</h2>
                <p>Your next adventures are waiting for you.</p>
            </div>
            <a href="/bookings" class="user-view-all-link">View All
                <i class="fa-solid fa-arrow-right"></i>
            </a>
        </div>
        <% if(upcomingBookings.length >0) {%>
            <div class="user-upcoming-bookings">
                <% for(let booking of upcomingBookings) {%>
                    <div class="user-upcoming-card">
                        <div class="user-upcoming-image">
                            <% if(booking.listing && booking.listing.image && booking.listing.image.url) {%>
                                <img src="<%= booking.listing.image.url%>" alt="<%= booking.listing.title%>">
                            <% } else { %>
                                <div class="user-no-image">
                                    <i class="fa-solid fa-house"></i>
                                </div>
                            <% } %>
                        </div>
                        <div class="user-upcoming-details">
                            <div class="user-booking-title-row">
                                <h3>
                                    <%= booking.listing? booking.listing.title:"Property Unavailable"%>
                                </h3>
                                <span class="user-booking-status status-<%= booking.status%>">
                                    <%= booking.status%>
                                </span>
                            </div>
                            <p class="user-booking-location">
                                <i class="fa-solid fa-location-dot"></i>
                                <%= booking.listing? booking.listing.location:"Location unavailable"%>
                            </p>
                            <div class="user-booking-info">
                                <span>
                                    <i class="fa-regular fa-calendar"></i>
                                    <%= new Date(booking.checkIn).toLocaleDateString("en-IN",{
                                        day:"numeric",
                                        month:"short",
                                        year: "numeric"
                                    })%>
                                </span>
                                <span>
                                    <i class="fa-solid fa-users"></i>
                                    <%= booking.guests%> Guests
                                </span>
                            </div>
                            <div class="user-booking-footer">
                                <p>Total Price:
                                    <strong>
                                        ₹<%= booking.totalPrice.toLocaleString("en-IN") %>
                                    </strong>
                                </p>
                            </div>
                        </div>
                    </div>
                <% } %>
            </div>
        <% } else { %>
            <div class="user-empty-bookings">
                <div class="user-empty-icon">
                    <i class="fa-solid fa-suitcase-rolling"></i>
                </div>
                <h3>No Upcoming Trips</h3>
                <p>Your next adventure starts with finding the perfect stay.</p>
                <a href="/listings" class="user-primary-btn">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    Explore Stays
                </a>
            </div>
        <% } %>
    </div>
        <!-- Quick Actions -->
    <section class="user-dashboard-section user-quick-actions-section">
        <div class="user-section-heading">
            <div>
                <h2>Quick Actions</h2>
                <p>Everything you need, just one click away.</p>
            </div>
        </div>
        <div class="user-quick-actions-grid">
            <!-- My Bookings -->
            <a href="/bookings" class="user-quick-action-card">
                <div class="user-action-icon action-bookings">
                    <i class="fa-solid fa-calendar-check"></i>
                </div>
                <div class="user-action-content">
                    <h3>My Bookings</h3>
                    <p>View and manage your reservations.</p>
                </div>
                <i class="fa-solid fa-arrow-right user-action-arrow"></i>
            </a>
            <!-- My Wishlist -->
            <a href="/users/wishlist" class="user-quick-action-card">
                <div class="user-action-icon action-wishlist">
                    <i class="fa-solid fa-heart"></i>
                </div>
                <div class="user-action-content">
                    <h3>My Wishlist</h3>
                    <p>Explore the stays you have saved.</p>
                </div>
                <i class="fa-solid fa-arrow-right user-action-arrow"></i>
            </a>
            <!-- Explore Stays -->
            <a href="/listings" class="user-quick-action-card">
                <div class="user-action-icon action-explore">
                    <i class="fa-solid fa-compass"></i>
                </div>
                <div class="user-action-content">
                    <h3>Explore Stays</h3>
                    <p>Discover your next favourite destination.</p>
                </div>
                <i class="fa-solid fa-arrow-right user-action-arrow"></i>
            </a>
            <!-- My Profile -->
            <a href="/users/profile" class="user-quick-action-card">
                <div class="user-action-icon action-profile">
                    <i class="fa-solid fa-user-pen"></i>
                </div>
                <div class="user-action-content">
                    <h3>My Profile</h3>
                    <p>View and update your account details.</p>
                </div>
                <i class="fa-solid fa-arrow-right user-action-arrow"></i>
            </a>
        </div>
    </section>
</div>