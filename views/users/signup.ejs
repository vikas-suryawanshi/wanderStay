<%-layout("/layouts/boilerplate.ejs") %>

<div class="row signup-card">
    <div class="col-12 col-md-6 offset-md-3 mt-5 signup card shadow-sm rounded-3 p-4">
        <h3 class="mb-4">Welcome to WanderStay</h3>
        <form method="post" action="/signup" novalidate class="needs-validation">
            <div class="mb-3">
                <label for="username" class="form-label">username</label>
                <input name="username" type="text"
                class="form-control" id="username"
                placeholder="enter username" required>
                <div class="invalid-feedback">enter a your username!</div>
            </div>
            <div class="mb-3">
                <label for="email" class="form-label">email</label>
                <input name="email" type="email"
                class="form-control" id="email"
                placeholder="enter email" required>
                <div class="invalid-feedback">enter a your email!</div>
            </div>
            <div class="mb-3">
                <label for="password" class="form-label">password</label>
                <input name="password" type="password"
                class="form-control" id="password" 
                placeholder="enter password"required>
                <div class="invalid-feedback">enter a your password!</div>
            </div>
            <button class="btn btn-primary">signUp</button>
        </form>
    </>
</div>            