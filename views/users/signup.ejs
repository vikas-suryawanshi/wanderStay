<%-layout("/layouts/boilerplate.ejs") %>

<div class="signup-page">
    <div class="signup-card">
        <div class="signup-header">
            <h3>Welcome to WanderStay</h3>
            <p>Create an account and start your journey with us</p>
        </div>
        <form method="post" action="/signup" novalidate class="needs-validation">
            <div class="signup-page-group">
                    <label for="username">Username</label>
                    <input name="username" type="text" id="username"
                    placeholder="Enter your username" required>
                    <div class="invalid-feedback">
                        Please enter your username.
                    </div>
            </div>
            <div class="signup-page-group">
                    <label for="fullName">Full Name</label>
                    <input name="fullName" type="text" placeholder="Enter your full name" id="fullName" required>
                    <div class="invalid-feedback">
                        Please enter your full name.
                    </div>
            </div>
                <div class="signup-page-group">
                    <label for="email">Email</label>
                    <input name="email" type="email"
                    id="email" placeholder="Enter your email" required>
                    <div class="invalid-feedback">enter a your email!</div>
                </div>
                <div class="mb-3">
                    <label for="password" class="form-label fw-semibold">Password</label>
                    <input name="password" type="password"
                    class="form-control rounded-3" id="password"
                    placeholder="Enter password" required>
                    <div class="invalid-feedback">enter a your password!</div>
                </div>
                <button class="signup-btn">signUp</button>
            </form>
        </div>
    </div>
</div>